{
  "name": "@advcomm/mtdd",
  "version": "1.0.0",
  "description": "PostgreSQL shard routing: SET mtdd.tid on the wire, Lookup placement, native results",
  "main": "dist/src/index.js",
  "types": "src/public-api.d.ts",
  "exports": {
    ".": {
      "types": "./src/public-api.d.ts",
      "default": "./dist/src/index.js"
    },
    "./register": {
      "types": "./src/public-api.d.ts",
      "default": "./dist/src/register.js"
    },
    "./context": {
      "types": "./src/public-api.d.ts",
      "default": "./dist/src/context.js"
    },
    "./hooks": {
      "types": "./src/public-api.d.ts",
      "default": "./dist/src/hooks.js"
    }
  },
  "files": [
    ".npmrc",
    ".env.example",
    "src/public-api.d.ts",
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "proto/",
    "docs/",
    "README.md",
    "INTEGRATION.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "test:integration": "npm run build && node dist/scripts/integration-smoke.js",
    "test:integration:notify-reconnect": "npm run build && node dist/scripts/integration-notify-reconnect-smoke.js",
    "mtdd-proxy": "node dist/src/proxy/main.js",
    "mtdd-proxy:probe": "node dist/scripts/haproxy/probe-tid.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "postgresql",
    "pg",
    "multi-tenant",
    "database",
    "routing"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opentelemetry/api": ">=1 <2",
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.6",
    "@grpc/proto-loader": "^0.7.13",
    "flatbuffers": "^25.9.23",
    "pg-copy-streams": "^6.0.6",
    "pgsql-ast-parser": "^12.0.2",
    "redis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/pg": "^8.11.14",
    "pg": "^8.13.0",
    "typescript": "^5.8.3"
  }
}
