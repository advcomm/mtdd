{
  "name": "@advcomm/mtdd",
  "version": "1.0.0",
  "description": "Production PostgreSQL interception and routing layer for Node.js pg applications",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./register": "./register.js",
    "./context": "./context.js",
    "./hooks": "./hooks.js"
  },
  "files": [
    "*.js",
    "proto/",
    "examples/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "postgresql",
    "pg",
    "multi-tenant",
    "database",
    "routing"
  ],
  "license": "MIT",
  "peerDependencies": {
    "pg": ">=8.0.0",
    "@opentelemetry/api": ">=1 <2"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.6",
    "@grpc/proto-loader": "^0.7.13",
    "pg-copy-streams": "^6.0.6",
    "pgsql-ast-parser": "^12.0.2",
    "redis": "^6.0.0"
  },
  "devDependencies": {
    "pg": "^8.13.0"
  }
}
