# @advcomm/mtdd — environment template
# Copy to .env:
#   cp .env.example .env
#
# Production path: vanilla pg → HAProxy GW VIP → mtdd-proxy → shard HAP → PG
# Do not --require @advcomm/mtdd/register
#
# App (single VIP, not a JSON array):
#   DB_HOST=127.0.0.1
#   DB_PORT=15432
#
# Lab: scripts/haproxy/README.md

# ── App / shared credentials ──────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=postgres
DB_HOST=127.0.0.1
DB_PORT=15432

# ── Lookup (binary-split; SHARD_COUNT must match shard list length) ───────────
MTDD_LOOKUP_URL=http://127.0.0.1:9090/lookup

# ── mtdd-proxy ────────────────────────────────────────────────────────────────
MTDD_PROXY_BIND=127.0.0.1
MTDD_PROXY_PORT=6432
MTDD_PROXY_HEALTH_PORT=6433
MTDD_PROXY_POOL_MAX=8

# JSON array, index = Lookup hostIndex. Through HAP shard VIPs:
MTDD_SHARD_HOSTS=[{"host":"127.0.0.1","port":15442,"database":"mtdd_shard_0"},{"host":"127.0.0.1","port":15443,"database":"mtdd_shard_1"}]

# Direct to Postgres (no HAP), two databases on one instance:
# MTDD_SHARD_HOSTS=[{"host":"127.0.0.1","port":5432,"database":"mtdd_shard_0"},{"host":"127.0.0.1","port":5432,"database":"mtdd_shard_1"}]

# ── Legacy gRPC preload (unsupported; install() only if MTDD_LEGACY_INSTALL=1)
# MTDD_LEGACY_INSTALL=0
# MTDD_GRPC_PORT=50051
# MTDD_GRPC_MOCK=0
